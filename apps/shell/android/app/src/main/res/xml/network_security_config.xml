<?xml version="1.0" encoding="utf-8"?>
<!-- https only, with the system's own certificates (spec §17). The e2e build overrides this file. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
